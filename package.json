{
  "name": "smurf-iot-village",
  "version": "1.0.0",
  "description": "Plateforme web interactive pour piloter le workshop IoT gamifié Le Village IoT des Schtroumpfs",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "node --watch server/server.js",
    "build": "cd frontend && npm run build",
    "frontend:dev": "cd frontend && npm run dev",
    "db:init": "node server/init-db.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "mysql2": "^3.11.3",
    "qrcode": "^1.5.4"
  }
}
